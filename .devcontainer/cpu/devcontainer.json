{
    "name": "CS336 Assignment 1 - Python with UV (CPU)",
    "dockerComposeFile": [
        "../docker-compose.yml",
        "docker-compose.cpu.yml"
    ],
    "service": "cs336-dev",
    "workspaceFolder": "/workspace",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/sshd:1": {
            "version": "latest",
            "password": "1234",
            "user": "vscode"
        }
    },
    "remoteEnv": {
        "PATH": "/opt/venv/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-toolsai.jupyter",
                "ms-python.isort",
                "ms-python.black-formatter"
            ],
            "settings": {
                "python.formatting.provider": "black",
                "python.defaultInterpreterPath": "/opt/venv/bin/python",
                "python.terminal.activateEnvironment": false,
                "python.analysis.typeCheckingMode": "basic",
                "files.associations": {
                    "*.lock": "toml"
                }
            }

            
        }
    },
    "forwardPorts": [
        8000,
        2222,
        8888
    ],
    "portsAttributes": {
        "2222": {
            "label": "SSH"
        }
    },
    "postCreateCommand": "mkdir -p ~/.ssh/; echo \"${JOZO_SSH}\" > ~/.ssh/id_jozo; echo \"${RUNPOD_SSH}\" > ~/.ssh/id_runpod; sudo chown -R vscode:vscode ~/.ssh && sudo chmod 700 ~/.ssh && sudo chmod 600 ~/.ssh/*",
    "remoteUser": "vscode"
}