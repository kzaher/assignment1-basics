{
    "name": "owt_sweep",
    "training_data_path": "data/owt_train.txt",
    "validation_data_path": "data/owt_valid.txt",
    "checkpoint_persist_modulus": 500,
    "adamw_optimizer_configuration": {
        "lr": 0.001,
        "weight_decay": 0.001,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-8
    },
    "transformer_llm": {
        "vocab_size": 32000,
        "max_sequence_length": 2048,
        "d_model": 768,
        "num_layers": 12,
        "num_heads": 12,
        "d_ff": 6400,
        "rope_theta": 10000,
        "device": "cuda",
        "dtype": "bfloat16",
        "experiments": {}
    },
    "annealing_configuration": {
        "zero_iters": 0,
        "warmup_iters": 500,
        "use_cosine_rampup": false,
        "max_learning_rate": 0.0005,
        "min_learning_rate": 0.00001,
        "cosine_cycle_iters": 10000
    },
    "context_length": 512,
    "batch_size": 32,
    "initial_max_l2_norm": 0.7,
    "max_iterations": 6000,
    "time_limit_in_seconds": 3600
}