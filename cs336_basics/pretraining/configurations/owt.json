{
    "name": "Owt",
    "checkpoint_persist_modulus": 500,
    "adamw_optimizer_configuration": {
        "lr": 0.001,
        "weight_decay": 0.001,
        "betas": [
            0.9,
            0.999
        ],
        "eps": 1e-8
    },
    "transformer_llm": {
        "vocab_size": 10000,
        "context_length": 256,
        "d_model": 768,
        "num_layers": 12,
        "num_heads": 12,
        "d_ff": 6400,
        "rope_theta": 10000,
        "device": "cuda",
        "dtype": "bfloat16"
    },
    "annealing_configuration": {
        "zero_iters": 3500,
        "warmup_iters": 5000,
        "use_cosine_rampup": true,
        "max_learning_rate": 0.0005,
        "min_learning_rate": 0.00001,
        "cosine_cycle_iters": 44000
    },
    "batch_size": 64,
    "context_length": 256,
    "initial_max_l2_norm": 0.7
}