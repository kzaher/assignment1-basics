{
    "name": "owt_gemma_270M",
    "training_data_path": "data/owt_train.txt",
    "validation_data_path": "data/owt_valid.txt",
    "checkpoint_persist_modulus": 500,
    "transformer_llm": {
        "vocab_size": 32000,
        "max_sequence_length": 1024,
        "d_model": 640,
        "num_layers": 18,
        "num_query_heads": 4,
        "num_key_value_heads": 1,
        "d_head": 256,
        "d_hidden": 2048,
        "rope_theta": 10000,
        "device": "cuda",
        "dtype_str": "bfloat16",
        "use_bias": false,
        "experiments": {
            "zero_output": true,
            "context_increment": 64
        }
    },
    "annealing_configuration": {
        "zero_iters": 0,
        "warmup_iters": 200,
        "use_cosine_rampup": false,
        "max_learning_rate": 0.001,
        "min_learning_rate": 0.0001,
        "ff_max_learning_rate": 0.001,
        "ff_min_learning_rate": 0.0001,
        "safe_max_learning_rate": 0.001,
        "safe_min_learning_rate": 0.0001,
        "cosine_cycle_iters": 4000
    },
    "adamw_optimizer_configuration": {
        "weight_decay": 0.0,
        "betas": [
            0.8,
            0.95
        ],
        "eps": 1e-10
    },
    "muon_optimizer_configuration": {
        "lr": 0.05,
        "momentum": 0.95,
        "weight_decay": 0.0
    },
    "context_length": 256,
    "batch_size": 256,
    "initial_max_l2_norm": 200000000,
    "max_iterations": 10000,
    "time_limit_in_seconds": 3600
}